---
import Base from '../layouts/Base.astro';
import { url } from '../lib/url';
---

<Base title="Page not found">
  <section class="wrap" style="padding-top: clamp(48px, 10vw, 140px);">
    <h1 style="font-size: var(--step-4); letter-spacing: -0.035em;">This page doesn’t exist.</h1>
    <p class="muted" style="margin-top: 20px; font-size: var(--step-1);">
      It may have moved when the portfolio was rebuilt. Start from the <a href={url('/')}>home page</a> or go
      straight to <a href={url('/#work')}>selected work</a>.
    </p>
  </section>
</Base>
