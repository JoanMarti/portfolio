---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ProjectCover from '../../components/ProjectCover.astro';
import { writing } from '../../data/writing';
import { url, filled } from '../../lib/url';

export async function getStaticPaths() {
  const projects = (await getCollection('projects', (p) => !p.data.draft)).sort(
    (a, b) => a.data.order - b.data.order,
  );
  return projects.map((project, i) => ({
    params: { slug: project.id },
    props: { project, next: projects[(i + 1) % projects.length] },
  }));
}

const { project, next } = Astro.props;
const { Content } = await render(project);
const d = project.data;

const facts = [
  ['Client', d.client],
  ['Role', d.role],
  ['Team', d.team],
  ['Duration', d.duration],
  ['Year', d.year],
  ['Sector', d.sector],
].filter(([, v]) => filled(v)) as [string, string][];

const tldrLabels = ['Problem', 'What I did', 'Result'];
const related = writing.filter((a) => a.relatedProject === project.id);
---

<Base title={d.title} description={d.summary} current="work">
  <article>
    <header class="cs-head wrap">
      <a class="back muted" href={url('/#work')}>All work</a>
      <h1>{d.headline}</h1>
      <p class="lede">{d.summary}</p>
    </header>

    <div class="wrap">
      <ProjectCover kind={d.cover} label={d.headline} />
    </div>

    <section class="overview wrap" aria-label="Overview">
      <dl class="facts">
        {facts.map(([k, v]) => (
          <div><dt>{k}</dt><dd>{v}</dd></div>
        ))}
        {d.tools.length > 0 && (
          <div><dt>Tools</dt><dd>{d.tools.join(', ')}</dd></div>
        )}
        {d.links.map((l) => (
          <div><dt>Link</dt><dd><a href={l.href} rel="noopener">{l.label}</a></dd></div>
        ))}
      </dl>

      <div class="tldr">
        <h2>In short</h2>
        <dl>
          {d.tldr.map((t, i) => (
            <div><dt>{tldrLabels[i]}</dt><dd>{t}</dd></div>
          ))}
        </dl>
      </div>
    </section>

    {d.metrics.length > 0 && (
      <section class="impact wrap" aria-labelledby="impact-h">
        <h2 id="impact-h">Impact</h2>
        <ul>
          {d.metrics.map((m) => (
            <li>
              <span class="m-value">{m.value}</span>
              <span class="m-label">{m.label}</span>
              {filled(m.method) && <span class="m-method muted">{m.method}</span>}
            </li>
          ))}
        </ul>
      </section>
    )}

    <div class="body wrap">
      <div class="prose">
        <Content />
      </div>
    </div>

    {related.length > 0 && (
      <aside class="related wrap" aria-label="Related writing">
        <p class="muted">Related writing</p>
        {related.map((a) => (
          <a href={a.url} rel="noopener">{a.title}</a>
        ))}
      </aside>
    )}

    <nav class="next wrap" aria-label="Next case study">
      <a href={url(`/work/${next.id}/`)}>
        <span class="muted">Next case study</span>
        <span class="next-title">{next.data.headline}</span>
      </a>
    </nav>
  </article>
</Base>

<style>
  .cs-head { padding-top: clamp(24px, 5vw, 64px); padding-bottom: 40px; }
  .back { font-size: var(--step--1); text-decoration: none; }
  .back::before { content: '← '; }
  .cs-head h1 { font-size: var(--step-4); letter-spacing: -0.035em; line-height: 1.04; max-width: 20ch; margin-top: 20px; }
  .lede { font-size: var(--step-1); line-height: 1.45; color: var(--muted); max-width: 48ch; margin-top: 24px; }

  .overview { display: grid; grid-template-columns: 4fr 8fr; gap: clamp(32px, 5vw, 72px); margin-top: clamp(40px, 6vw, 72px); }
  .facts { margin: 0; display: grid; gap: 18px; align-content: start; font-size: var(--step--1); }
  .facts dt { color: var(--muted); }
  .facts dd { margin: 2px 0 0; font-weight: 500; }
  .tldr h2 { font-size: var(--step-2); margin-bottom: 20px; }
  .tldr dl { margin: 0; display: grid; gap: 20px; }
  .tldr div { display: grid; grid-template-columns: 7.5rem 1fr; gap: 16px; padding-top: 16px; border-top: 1px solid var(--line); }
  .tldr dt { font-weight: 650; }
  .tldr dd { margin: 0; max-width: 60ch; }
  @media (max-width: 760px) {
    .overview { grid-template-columns: 1fr; }
    .facts { grid-template-columns: 1fr 1fr; }
    .tldr div { grid-template-columns: 1fr; gap: 4px; }
  }

  .impact { margin-top: clamp(56px, 8vw, 96px); }
  .impact h2 { font-size: var(--step-2); padding-bottom: 16px; border-bottom: 1px solid var(--line); }
  .impact ul { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 32px; margin-top: 28px; }
  .impact li { display: grid; gap: 6px; align-content: start; }
  .m-value { font-size: var(--step-3); font-weight: 700; letter-spacing: -0.03em; line-height: 1; font-variant-numeric: tabular-nums; color: var(--accent); }
  .m-label { font-weight: 600; }
  .m-method { font-size: var(--step--1); line-height: 1.45; }

  .body { margin-top: clamp(32px, 5vw, 48px); }
  .body .prose { margin-left: calc((100% - var(--measure)) * 0.33); }
  @media (max-width: 1000px) { .body .prose { margin-left: 0; } }

  .related { margin-top: 64px; display: grid; gap: 8px; }
  .related a { font-weight: 600; font-size: var(--step-1); }

  .next { margin-top: clamp(64px, 9vw, 120px); }
  .next a { display: grid; gap: 8px; padding-top: 24px; border-top: 1px solid var(--line); text-decoration: none; }
  .next-title { font-size: var(--step-3); font-weight: 700; letter-spacing: -0.025em; line-height: 1.1; max-width: 22ch; }
  .next a:hover .next-title { color: var(--accent); }
</style>
