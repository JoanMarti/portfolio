---
import '../styles/global.css';
import { site } from '../data/site';
import { url } from '../lib/url';
import { ui, langs, langNames, href, defaultLang, type Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
  path: string; // language-neutral path of this page, e.g. "/work/glencore-ctrm/"
  title?: string;
  description?: string;
  current?: 'work' | 'about' | 'writing';
  alternates?: Lang[]; // languages this page exists in (default: all)
}
const { lang, path, title, description = site.metaDescription[lang], current, alternates = [...langs] } = Astro.props;
const t = ui[lang];
const pageTitle = title ? `${title}, ${site.name}` : site.metaTitle[lang];
const canonical = new URL(href(lang, path), Astro.site);

const nav = [
  { href: href(lang, '/') + '#work', label: t.nav.work, key: 'work' },
  { href: href(lang, '/about/'), label: t.nav.about, key: 'about' },
  { href: href(lang, '/writing/'), label: t.nav.writing, key: 'writing' },
];
import { existsSync } from 'node:fs';
// Only offer the CV download once the PDF is in /public.
const hasCv = existsSync(`public/${site.cv}`);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {alternates.map((l) => (
      <link rel="alternate" hreflang={l} href={new URL(href(l, path), Astro.site)} />
    ))}
    <link rel="alternate" hreflang="x-default" href={new URL(href(defaultLang, path), Astro.site)} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang} />
    <meta property="og:image" content={new URL(url('/og.png'), Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Schibsted+Grotesk:ital,wght@0,400..900;1,400..900&display=swap"
      rel="stylesheet"
    />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Person',
      name: site.name,
      jobTitle: site.role,
      address: { '@type': 'PostalAddress', addressLocality: 'Zug', addressCountry: 'CH' },
      url: new URL('/', Astro.site).href,
      image: new URL('/joan-marti-diez.webp', Astro.site).href,
      email: `mailto:${site.email}`,
      knowsLanguage: ['es', 'ca', 'en', 'de', 'fr', 'it'],
      knowsAbout: ['Product design', 'UX design', 'Design systems', 'Fintech', 'Trading platforms', 'Figma', 'Angular', 'Flutter'],
      sameAs: site.social.filter((s) => s.href).map((s) => s.href),
    })} />
    {site.gtm && (
      <script is:inline define:vars={{ gtmId: site.gtm, ga4Id: site.ga4 }}>
        // Consent Mode v2: nothing is stored until the visitor accepts analytics cookies.
        window.dataLayer = window.dataLayer || [];
        // define:vars wraps this script in a function, so expose gtag globally for the consent banner.
        window.gtag = function () { window.dataLayer.push(arguments); };
        var gtag = window.gtag;
        var choice = null;
        try { choice = localStorage.getItem('consent-analytics'); } catch (e) {}
        gtag('consent', 'default', {
          ad_storage: 'denied', ad_user_data: 'denied', ad_personalization: 'denied',
          analytics_storage: choice === 'granted' ? 'granted' : 'denied',
          wait_for_update: 500,
        });
        // Official Google Tag Manager snippet
        (function (w, d, s, l, i) {
          w[l] = w[l] || []; w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
          var f = d.getElementsByTagName(s)[0], j = d.createElement(s), dl = l != 'dataLayer' ? '&l=' + l : '';
          j.async = true; j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i + dl; f.parentNode.insertBefore(j, f);
        })(window, document, 'script', 'dataLayer', gtmId);
        // Google Analytics 4 (respects the consent state above)
        if (ga4Id) {
          var g = document.createElement('script');
          g.async = true; g.src = 'https://www.googletagmanager.com/gtag/js?id=' + ga4Id;
          document.head.appendChild(g);
          gtag('js', new Date());
          gtag('config', ga4Id);
        }
      </script>
    )}
  </head>
  <body>
    {site.gtm && <noscript><iframe src={`https://www.googletagmanager.com/ns.html?id=${site.gtm}`} height="0" width="0" style="display:none;visibility:hidden" title="Google Tag Manager"></iframe></noscript>}
    <a class="skip" href="#main">{t.skip}</a>
    <header class="site-header wrap">
      <a href={href(lang, '/')} class="brand">
        <span class="brand-name">{site.name}</span>
        <span class="brand-role">{site.role}</span>
      </a>
      <div class="header-right">
        <nav aria-label="Main">
          {nav.map((item) => (
            <a href={item.href} aria-current={current === item.key ? 'page' : undefined}>{item.label}</a>
          ))}
          <a href="#contact" class="nav-cta">{t.nav.contact}</a>
        </nav>
        <nav class="langs" aria-label={t.nav.language}>
          {langs.map((l) =>
            l === lang ? (
              <span aria-current="true" title={langNames[l]}>{l.toUpperCase()}</span>
            ) : (
              <a href={href(alternates.includes(l) ? l : l, alternates.includes(l) ? path : '/')} hreflang={l} lang={l} title={langNames[l]}>{l.toUpperCase()}</a>
            ),
          )}
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer id="contact" class="site-footer">
      <div class="wrap footer-grid">
        <div>
          <h2 class="footer-title">{t.footer.title}</h2>
          <p class="muted footer-sub">{site.availability.text[lang]}</p>
        </div>
        <div class="footer-actions">
          <a class="btn btn--primary" href={`mailto:${site.email}`}>{t.footer.email} {site.email}</a>
          {site.calendar && <a class="btn" href={site.calendar}>{t.footer.call}</a>}
          {hasCv && <a class="btn" href={url(`/${site.cv}`)} download>{t.footer.cv}</a>}
          <a class="btn" href={site.social[0].href} rel="me noopener">LinkedIn</a>
        </div>
        <ul class="footer-links" aria-label={t.footer.elsewhere}>
          {site.social.filter((s) => s.href).map((s) => (
            <li><a href={s.href} rel="me noopener">{s.label}</a></li>
          ))}
        </ul>
        <p class="footer-meta muted">© {new Date().getFullYear()} {site.name}, {site.location[lang]}{site.gtm && <> · <button type="button" class="linklike consent-open">{t.consent.settings}</button></>}</p>
      </div>
    </footer>
    {site.gtm && (
      <div class="consent" role="region" aria-label={t.consent.label} hidden>
        <p>{t.consent.text}</p>
        <div class="consent-actions">
          <button type="button" class="btn" data-consent="denied">{t.consent.decline}</button>
          <button type="button" class="btn btn--primary" data-consent="granted">{t.consent.accept}</button>
        </div>
      </div>
    )}
    <script is:inline data-global>
      // Tabs (work section): click or arrow keys switch panels. Delegated, so it also
      // works when page content is swapped in without a reload.
      (function () {
        function select(tab) {
          var list = tab.closest('[role="tablist"]');
          list.querySelectorAll('[role="tab"]').forEach(function (t) {
            var on = t === tab;
            t.setAttribute('aria-selected', on ? 'true' : 'false');
            t.tabIndex = on ? 0 : -1;
            var panel = document.getElementById(t.getAttribute('aria-controls'));
            if (panel) panel.hidden = !on;
          });
        }
        document.addEventListener('click', function (e) {
          var tab = e.target.closest && e.target.closest('[role="tab"]');
          if (tab) select(tab);
        });
        document.addEventListener('keydown', function (e) {
          var tab = e.target.closest && e.target.closest('[role="tab"]');
          if (!tab || (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft')) return;
          var tabs = Array.prototype.slice.call(tab.closest('[role="tablist"]').querySelectorAll('[role="tab"]'));
          var next = tabs[(tabs.indexOf(tab) + (e.key === 'ArrowRight' ? 1 : tabs.length - 1)) % tabs.length];
          select(next); next.focus(); e.preventDefault();
        });
      })();
      // Cookie consent banner for analytics (Consent Mode v2).
      (function () {
        var box = document.querySelector('.consent');
        if (!box || typeof gtag !== 'function') return;
        var stored = null;
        try { stored = localStorage.getItem('consent-analytics'); } catch (e) {}
        if (!stored) box.hidden = false;
        document.addEventListener('click', function (e) {
          var b = e.target.closest && e.target.closest('[data-consent]');
          if (b) {
            var v = b.dataset.consent;
            gtag('consent', 'update', { analytics_storage: v });
            try { localStorage.setItem('consent-analytics', v); } catch (x) {}
            box.hidden = true;
            return;
          }
          if (e.target.closest && e.target.closest('.consent-open')) { box.hidden = false; box.querySelector('[data-consent=granted]').focus(); }
        });
      })();
      // Protected sections: decrypt in the browser with the password (AES-GCM, PBKDF2 SHA-256).
      (function () {
        var fromB64 = function (s) { return Uint8Array.from(atob(s), function (c) { return c.charCodeAt(0); }); };
        async function unlock(section, pass) {
          var d = JSON.parse(section.querySelector('.locked-data').textContent);
          var enc = new TextEncoder();
          var base = await crypto.subtle.importKey('raw', enc.encode(pass), 'PBKDF2', false, ['deriveKey']);
          var key = await crypto.subtle.deriveKey({ name: 'PBKDF2', salt: fromB64(d.salt), iterations: d.iter, hash: 'SHA-256' },
            base, { name: 'AES-GCM', length: 256 }, false, ['decrypt']);
          var html = new TextDecoder().decode(await crypto.subtle.decrypt({ name: 'AES-GCM', iv: fromB64(d.iv) }, key, fromB64(d.ct)));
          var box = section.querySelector('.locked-content');
          box.innerHTML = html;
          box.hidden = false;
          section.classList.add('is-unlocked');
          var st = section.querySelector('.locked-state');
          if (st) st.textContent = st.dataset.unlocked;
          var f = section.querySelector('.locked-form'); if (f) f.hidden = true;
          var a = section.querySelector('.locked-ask'); if (a) a.hidden = true;
          try { sessionStorage.setItem('lock:' + section.dataset.locked, pass); } catch (e) {}
        }
        document.addEventListener('submit', async function (e) {
          var form = e.target.closest && e.target.closest('.locked-form');
          if (!form) return;
          e.preventDefault();
          var section = form.closest('.locked');
          var err = form.querySelector('.locked-error');
          var btn = form.querySelector('button');
          btn.disabled = true; err.hidden = true;
          try { await unlock(section, form.password.value); }
          catch (x) { err.hidden = false; form.password.select(); }
          finally { btn.disabled = false; }
        });
        function auto() {
          document.querySelectorAll('.locked:not(.is-unlocked):not(.is-busy)').forEach(function (s) {
            var p = null; try { p = sessionStorage.getItem('lock:' + s.dataset.locked); } catch (e) {}
            if (!p) return;
            s.classList.add('is-busy');
            unlock(s, p).catch(function () {}).finally(function () { s.classList.remove('is-busy'); });
          });
        }
        if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', auto); else auto();
        new MutationObserver(auto).observe(document.documentElement, { childList: true, subtree: true });
      })();
    </script>
  </body>
</html>

<style>
  .site-header {
    display: flex; justify-content: space-between; align-items: center; gap: 24px;
    padding-top: 24px; padding-bottom: 24px;
  }
  .brand { display: flex; flex-direction: column; text-decoration: none; line-height: 1.25; }
  .brand-name { font-weight: 700; }
  .brand-role { color: var(--muted); font-size: var(--step--1); }
  .header-right { display: flex; align-items: center; gap: clamp(16px, 3vw, 36px); flex-wrap: wrap; }
  nav { display: flex; gap: clamp(14px, 3vw, 32px); align-items: center; }
  nav a { text-decoration: none; font-weight: 500; }
  nav a[aria-current='page'] { text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 6px; }
  .nav-cta { color: var(--accent); }
  .langs { gap: 2px; font-size: var(--step--1); font-weight: 600; border: 1px solid var(--line); border-radius: 999px; padding: 3px; }
  .langs a, .langs span { padding: 3px 9px; border-radius: 999px; letter-spacing: 0.04em; }
  .langs span { background: var(--ink); color: var(--paper); }
  .langs a { color: var(--muted); }
  .langs a:hover { color: var(--ink); background: var(--paper-2); }
  @media (max-width: 640px) {
    .site-header { flex-direction: column; align-items: flex-start; gap: 12px; }
  }

  .site-footer {
    margin-top: clamp(80px, 12vw, 160px);
    background: var(--ink); color: var(--paper);
    padding: clamp(56px, 8vw, 96px) 0 40px;
    --muted: color-mix(in srgb, var(--paper) 65%, var(--ink));
  }
  .site-footer a:hover { color: var(--paper); text-decoration-thickness: 2px; }
  .site-footer .btn { color: var(--paper); border-color: var(--paper); }
  .site-footer .btn:hover { background: var(--paper); color: var(--ink); }
  .site-footer .btn--primary { background: var(--paper); color: var(--ink); }
  .site-footer .btn--primary:hover { background: transparent; color: var(--paper); }
  .footer-grid { display: grid; gap: 40px; }
  .footer-title { font-size: var(--step-3); max-width: 20ch; }
  .footer-sub { margin-top: 16px; max-width: 52ch; }
  .footer-actions { display: flex; flex-wrap: wrap; gap: 12px; }
  .footer-links { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px 28px; }
  .footer-meta { font-size: var(--step--1); }
</style>
