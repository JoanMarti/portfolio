---
// Chooses the cover for a case study: a real image when `coverImage` is set
// in the front matter, otherwise the diagram cover.
import ProjectCover from './ProjectCover.astro';
import { url } from '../lib/url';
import type { Lang } from '../lib/i18n';

interface Props {
  data: {
    cover?: 'layers' | 'tenants' | 'branching' | 'loop' | 'hmi' | 'mood' | 'signals' | 'ia';
    coverImage?: { src: string; alt: string };
    headline: string;
  };
  size?: 'large' | 'small';
  lang?: Lang;
}
const { data, size = 'large', lang = 'en' } = Astro.props;
---

{data.coverImage ? (
  <figure class={`img-cover img-cover--${size}`}>
    <img src={url(data.coverImage.src)} alt={data.coverImage.alt} loading={size === 'small' ? 'lazy' : 'eager'} decoding="async" />
  </figure>
) : (
  <ProjectCover kind={data.cover ?? 'layers'} label={data.headline} size={size} lang={lang} />
)}

<style>
  .img-cover { margin: 0; border-radius: var(--radius-lg); overflow: hidden; aspect-ratio: 8 / 5; background: var(--paper-2); }
  .img-cover img { display: block; width: 100%; height: 100%; object-fit: cover; }
</style>
