---
// Hero visual: how Joan works, set as three layers of type.
// Product in solid cobalt in front, System translucent behind it, Foundations in outline at the back.
// On load the words start stacked and split into their strata once. Hovering, focusing or tapping
// an item in the legend brings that layer forward. Reduced motion shows the resting state only.
interface Props {
  layers: { name: string; note: string }[]; // top to bottom
  label: string;
}
const { layers, label } = Astro.props;
---

<figure class="strata" aria-label={label}>
  <div class="words" aria-hidden="true">
    {layers.map((l, i) => <span class={`w w${i}`}>{l.name}</span>)}
  </div>
  <figcaption class="legend">
    {layers.map((l, i) => (
      <button type="button" class="key" data-i={i} aria-pressed="false">
        <b>{l.name}</b><span>{l.note}</span>
      </button>
    ))}
  </figcaption>
</figure>

<script>
  document.querySelectorAll<HTMLElement>('.strata').forEach((fig) => {
    const words = [...fig.querySelectorAll<HTMLElement>('.w')];
    const keys = [...fig.querySelectorAll<HTMLButtonElement>('.key')];
    let pinned = -1;
    const show = (i: number) => {
      fig.classList.toggle('focus', i >= 0);
      words.forEach((w, k) => w.classList.toggle('on', k === i));
      keys.forEach((b, k) => b.setAttribute('aria-pressed', String(k === i && pinned === i)));
    };
    keys.forEach((b, i) => {
      b.addEventListener('mouseenter', () => show(i));
      b.addEventListener('focus', () => show(i));
      b.addEventListener('mouseleave', () => show(pinned));
      b.addEventListener('blur', () => show(pinned));
      b.addEventListener('click', () => { pinned = pinned === i ? -1 : i; show(pinned); });
    });
  });
</script>

<style>
  .strata { margin: 0; container-type: inline-size; }
  .words { display: flex; flex-direction: column; padding-top: 0.1em; }
  .w {
    display: block; font-family: var(--font-display); font-weight: 420; line-height: 0.8;
    letter-spacing: -0.045em; white-space: nowrap; position: relative;
    transition: opacity 0.4s ease, transform 0.6s cubic-bezier(0.2, 0.7, 0.1, 1);
  }
  .w + .w { margin-top: -0.17em; }
  .w0 { font-size: 23cqi; color: var(--accent); z-index: 3; mix-blend-mode: multiply; }
  .w1 { font-size: 23cqi; color: var(--ink); opacity: 0.16; padding-left: 0.32em; z-index: 2; }
  .w2 { font-size: 17.5cqi; color: transparent; -webkit-text-stroke: 1.1px var(--ink); z-index: 1; }

  .strata.focus .w { opacity: 0.1; }
  .strata.focus .w.on { opacity: 1; transform: translateX(0.08em); }

  .legend { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; margin-top: clamp(28px, 4vw, 44px); }
  .key {
    all: unset; cursor: pointer; display: grid; gap: 2px; align-content: start;
    font-size: var(--step--1); color: var(--muted); line-height: 1.4;
  }
  .key b { color: var(--ink); font-weight: 600; }
  .key:first-child b { color: var(--accent); }
  .key:hover b, .key[aria-pressed='true'] b { text-decoration: underline; text-underline-offset: 4px; }
  .key:focus-visible { outline: 2px solid var(--accent); outline-offset: 4px; border-radius: 2px; }

  @media (prefers-color-scheme: dark) {
    .w0 { mix-blend-mode: normal; }
  }
  @media (prefers-reduced-motion: no-preference) {
    .w0 { animation: split-up 1.3s cubic-bezier(0.2, 0.7, 0.1, 1) 0.4s backwards; }
    .w1 { animation: appear 1s ease 0.8s backwards; }
    .w2 { animation: split-down 1.3s cubic-bezier(0.2, 0.7, 0.1, 1) 0.4s backwards; }
    @keyframes split-up { from { transform: translateY(0.5em); } to { transform: none; } }
    @keyframes split-down { from { transform: translateY(-0.7em); opacity: 0.2; } to { transform: none; opacity: 1; } }
    @keyframes appear { from { opacity: 0; } to { opacity: 0.16; } }
  }
  @media (prefers-reduced-motion: reduce) {
    .w { transition: none; }
  }
</style>
